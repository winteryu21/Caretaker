# ===================================================
# CARETAKER — .gitignore
# Based on: https://github.com/github/gitignore/blob/main/Unity.gitignore
# + Windows/macOS/Linux + IDE + Project-specific
# ===================================================

# -----------------------
# Unity Generated Folders
# -----------------------
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# -----------------------
# Unity Auto-Generated Files
# -----------------------
*.log
*.blend1
*.blend1.meta
mono_crash.*
sysinfo.txt
crashlytics-build.properties

# Auto-generated test scenes
InitTestScene*.unity*
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Scene dependency cache
[Aa]ssets/[Ss]ceneDependencyCache*

# Unity auto-generated shader variants
ShaderVariants/

# Unity Asset Store tools (uncomment if needed)
# [Aa]ssets/AssetStoreTools*

# -----------------------
# Unity Meta Files
# Only ignore metas for non-tracked files
# (Do NOT add a blanket *.meta ignore — Unity needs them)
# -----------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.unitypackage.meta

# -----------------------
# Visual Studio / Rider / Consulo
# -----------------------
.vs/
.idea/
.consulo/
ExportedObj/
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.userosscache
*.sln.docview
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb

# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# -----------------------
# OS Generated
# -----------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# -----------------------
# Build Artifacts
# -----------------------
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86
*.x86_64
*.BC
Crashes/

# -----------------------
# Gradle (Android builds)
# -----------------------
.gradle/

# -----------------------
# Python (tools/)
# -----------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.env
.venv
venv/
pip-log.txt

# -----------------------
# Node (if any tooling)
# -----------------------
node_modules/
npm-debug.log*

# -----------------------
# dotnet
# -----------------------
*.nupkg

# -----------------------
# Local Config (secrets)
# -----------------------
.env.local
secrets.json
config.local.*

# -----------------------
# Project Context
# -----------------------
CONTEXT.md
